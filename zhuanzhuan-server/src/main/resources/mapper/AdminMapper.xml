<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhuanzhuan.mapper.administrator.AdminMapper">

    <resultMap id="BaseResultMap" type="com.zhuanzhuan.entity.Admin">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createUser" column="create_user"/>
        <result property="updateUser" column="update_user"/>
    </resultMap>

    <sql id="BaseColumns">
        id, username, password, name, phone, status, create_time, update_time, create_user, update_user
    </sql>

    <select id="getByUsername" resultMap="BaseResultMap">
        select
        <include refid="BaseColumns"/>
        from admin
        where username = #{username}
        limit 1
    </select>

    <select id="getById" resultMap="BaseResultMap">
        select
        <include refid="BaseColumns"/>
        from admin
        where id = #{id}
        limit 1
    </select>

    <select id="pageQuery" resultType="com.zhuanzhuan.vo.AdminVO">
        select
            id,
            username,
            name,
            phone,
            status,
            create_time,
            update_time
        from admin
        <where>
            <if test="name != null and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
            <if test="username != null and username != ''">
                and username like concat('%', #{username}, '%')
            </if>
            <if test="phone != null and phone != ''">
                and phone like concat('%', #{phone}, '%')
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
        order by id desc
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into admin (
            username,
            password,
            name,
            phone,
            status,
            create_time,
            update_time,
            create_user,
            update_user
        ) values (
            #{username},
            #{password},
            #{name},
            #{phone},
            #{status},
            #{createTime},
            #{updateTime},
            #{createUser},
            #{updateUser}
        )
    </insert>

    <update id="updateByIdSelective">
        update admin
        <set>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="phone != null">
                phone = #{phone},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="updateUser != null">
                update_user = #{updateUser},
            </if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from admin
        where id = #{id}
    </delete>

    <select id="countByUsernameExcludeId" resultType="java.lang.Integer">
        select count(1)
        from admin
        where username = #{username}
          and id != #{id}
    </select>

    <select id="countByStatus" resultType="java.lang.Integer">
        select count(1)
        from admin
        where status = #{status}
    </select>

</mapper>
