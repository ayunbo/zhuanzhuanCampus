<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhuanzhuan.mapper.user.UserMapper">

    <resultMap id="BaseResultMap" type="com.zhuanzhuan.entity.User">
        <id property="id" column="id"/>
        <result property="studentNo" column="student_no"/>
        <result property="password" column="password"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="avatar" column="avatar"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="campus" column="campus"/>
        <result property="intro" column="intro"/>
        <result property="scoreAvg" column="score_avg"/>
        <result property="reviewCount" column="review_count"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createUser" column="create_user"/>
        <result property="updateUser" column="update_user"/>
    </resultMap>

    <sql id="BaseColumns">
        id, student_no, password, name, phone, avatar, role, status, campus, intro,
        score_avg, review_count, create_time, update_time, create_user, update_user
    </sql>

    <select id="getByStudentNo" resultMap="BaseResultMap">
        select
        <include refid="BaseColumns"/>
        from `user`
        where student_no = #{studentNo}
        limit 1
    </select>

    <select id="getByPhone" resultMap="BaseResultMap">
        select
        <include refid="BaseColumns"/>
        from `user`
        where phone = #{phone}
        limit 1
    </select>

    <select id="getByStudentNoOrPhone" resultMap="BaseResultMap">
        select
        <include refid="BaseColumns"/>
        from `user`
        where student_no = #{account}
           or phone = #{account}
        order by case when student_no = #{account} then 0 else 1 end
        limit 1
    </select>

    <select id="getById" resultMap="BaseResultMap">
        select
        <include refid="BaseColumns"/>
        from `user`
        where id = #{id}
        limit 1
    </select>

    <select id="pageQueryAdmin" resultType="com.zhuanzhuan.vo.UserProfileVO">
        select
            id,
            student_no,
            name,
            phone,
            avatar,
            role,
            status,
            campus,
            intro,
            score_avg,
            review_count,
            create_time,
            update_time
        from `user`
        <where>
            <if test="studentNo != null and studentNo != ''">
                and student_no like concat('%', #{studentNo}, '%')
            </if>
            <if test="name != null and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
            <if test="phone != null and phone != ''">
                and phone like concat('%', #{phone}, '%')
            </if>
            <if test="role != null">
                and role = #{role}
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
        order by id desc
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into `user` (
            student_no,
            password,
            name,
            phone,
            avatar,
            role,
            status,
            campus,
            intro,
            score_avg,
            review_count,
            create_time,
            update_time,
            create_user,
            update_user
        ) values (
            #{studentNo},
            #{password},
            #{name},
            #{phone},
            #{avatar},
            #{role},
            #{status},
            #{campus},
            #{intro},
            0.00,
            0,
            now(),
            now(),
            0,
            0
        )
    </insert>

    <select id="countByPhoneExcludeId" resultType="java.lang.Integer">
        select count(1)
        from `user`
        where phone = #{phone}
          and id != #{id}
    </select>

    <update id="updateByIdSelective">
        update `user`
        <set>
            <if test="studentNo != null and studentNo != ''">
                student_no = #{studentNo},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <if test="avatar != null and avatar != ''">
                avatar = #{avatar},
            </if>
            <if test="campus != null and campus != ''">
                campus = #{campus},
            </if>
            <if test="intro != null">
                intro = #{intro},
            </if>
            <if test="role != null">
                role = #{role},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="updateUser != null">
                update_user = #{updateUser},
            </if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from `user`
        where id = #{id}
    </delete>

    <update id="updateRoleById">
        update `user`
        set role = #{role}
        where id = #{id}
    </update>

</mapper>
