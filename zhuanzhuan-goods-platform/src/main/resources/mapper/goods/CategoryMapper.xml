<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhuanzhuan.platform.goods.mapper.CategoryMapper">

    <resultMap id="BaseResultMap" type="com.zhuanzhuan.entity.Category">
        <id property="id" column="id"/>
        <result property="parentId" column="parent_id"/>
        <result property="name" column="name"/>
        <result property="level" column="level"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createUser" column="create_user"/>
        <result property="updateUser" column="update_user"/>
    </resultMap>

    <sql id="BaseColumns">
        id, parent_id, name, level, sort, status, create_time, update_time, create_user, update_user
    </sql>

    <select id="getById" resultMap="BaseResultMap">
        select
        <include refid="BaseColumns"/>
        from category
        where id = #{id}
        limit 1
    </select>

    <select id="countByParentIdAndName" resultType="java.lang.Integer">
        select count(1)
        from category
        where parent_id = #{parentId}
          and name = #{name}
    </select>

    <select id="countByParentIdAndNameExcludeId" resultType="java.lang.Integer">
        select count(1)
        from category
        where parent_id = #{parentId}
          and name = #{name}
          and id != #{id}
    </select>

    <insert id="insert">
        insert into category (
            id,
            parent_id,
            name,
            level,
            sort,
            status,
            create_time,
            update_time,
            create_user,
            update_user
        ) values (
            #{id},
            #{parentId},
            #{name},
            #{level},
            #{sort},
            #{status},
            #{createTime},
            #{updateTime},
            #{createUser},
            #{updateUser}
        )
    </insert>

    <update id="updateByIdSelective">
        update category
        <set>
            <if test="parentId != null">
                parent_id = #{parentId},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="level != null">
                level = #{level},
            </if>
            <if test="sort != null">
                sort = #{sort},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="updateUser != null">
                update_user = #{updateUser},
            </if>
        </set>
        where id = #{id}
    </update>

    <select id="pageQuery" resultType="com.zhuanzhuan.vo.CategoryVO">
        select
            id,
            parent_id,
            name,
            level,
            sort,
            status,
            create_time,
            update_time
        from category
        <where>
            <if test="name != null and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
            <if test="parentId != null">
                and parent_id = #{parentId}
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
        order by level asc, sort asc, id asc
    </select>

    <select id="listByStatus" resultMap="BaseResultMap">
        select
        <include refid="BaseColumns"/>
        from category
        <where>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
        order by level asc, sort asc, id asc
    </select>

    <select id="listByParentId" resultMap="BaseResultMap">
        select
        <include refid="BaseColumns"/>
        from category
        where parent_id = #{parentId}
        order by sort asc, id asc
    </select>

    <select id="countChildrenByParentId" resultType="java.lang.Integer">
        select count(1)
        from category
        where parent_id = #{parentId}
    </select>

    <select id="countGoodsByCategoryId" resultType="java.lang.Integer">
        select count(1)
        from goods
        where category_id = #{categoryId}
    </select>

    <delete id="deleteById">
        delete from category
        where id = #{id}
    </delete>

</mapper>
